{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berlin-spike",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },

  "d1_databases": [
    { "binding": "DB", "database_name": "berlin-spike", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "images_spike_namespace" },
    { "binding": "CACHE", "id": "cache_spike_namespace" }
  ],

  // SPICE-ONLY overrides. In production, delete HORDE_BASE_URL (the code defaults to
  // https://aihorde.net/api) and set HORDE_API_KEY via `wrangler secret put`.
  "vars": {
    "HORDE_BASE_URL": "http://127.0.0.1:8788",
    "HORDE_API_KEY": "spike-key",
    "CLIENT_AGENT": "berlin-spike/0.1",
    "RESULT_TTL_HOURS": "24"
  },

  // The watcher. 1 of the 5 Cron Triggers the free plan gives you.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
